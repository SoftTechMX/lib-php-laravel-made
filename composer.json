{
    "name": "soft-tech-mx/laravel-made",
    "description": "Conjunto base de dependencias y configuración inicial que SoftTechMX usa en todos sus proyectos Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "boilerplate", "softtechmx"],
    "authors": [
        {
            "name": "Bayron Vazquez",
            "email": "bayronnjonathan@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/ui": "^4.6",
        "livewire/livewire": "^3",
        "soft-tech-mx/laravel-logger": "^1.1",
        "spatie/laravel-permission": "^6.25",
        "phpoffice/phpspreadsheet": "^5.10",
        "soft-tech-mx/os-reccon": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "SoftTechMX\\LaravelMade\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SoftTechMX\\LaravelMade\\LaravelMadeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}